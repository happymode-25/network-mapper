# --- Database / Queue ---
DATABASE_URL=postgresql+psycopg://network_mapper:network_mapper@db:5432/network_mapper
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth (disabled for the open-access demo) ---
# The hosted demo runs with no login screen. To re-enable JWT login, restore
# the auth module (backend/app/api/auth.py + the JWT helpers) from the
# project history; the settings SECRET_KEY / DEFAULT_ADMIN_* will then be
# re-added to config.py as well.

# --- Scanning security ---
# Comma-separated allowlist of IPs / CIDRs. Loopback is allowed only if listed.
ALLOWED_TARGETS=127.0.0.1, 10.0.0.0/8, 192.168.0.0/16, 172.16.0.0/12
SCAN_CONCURRENCY=50
SCAN_PORT_TIMEOUT=1.0
MAX_PORTS_PER_SCAN=4096
RATE_LIMIT_SCANS_PER_MINUTE=5
AUDIT_LOG_FILE=audit.log

# --- Fingerprinting ---
# Built-in TLS/HTTP probes identify bannerless services (no extra software).
FINGERPRINT_PROBE=true
FINGERPRINT_TIMEOUT=3.0
# Optional Nmap -sV integration for deep version detection (opt-in; needs the
# nmap binary installed). Leave off to stay 100% dependency-free.
# Windows default install path: C:\Program Files (x86)\Nmap\nmap.exe
USE_NMAP=false
NMAP_BINARY=nmap
NMAP_TIMEOUT=180

# --- Vulnerability intelligence ---
# Optional NIST NVD API 2.0 key (raises rate limits from 5 to 50 req/30s).
NVD_API_KEY=
# When true, matcher uses bundled matcher/data/sample_cves.json instead of NVD.
USE_SAMPLE_CVES=true

# --- Local demo mode (no Docker/Redis) ---
# Set true to run scans inline in the API process and auto-create the schema
# for SQLite. Ideal for local demos: uvicorn backend.app.main:app, then scan.
# INLINE_SCANS=true
# DATABASE_URL=sqlite:///./local.db

# --- Frontend ---
# Base URL the browser uses to reach the backend ("" = same origin + nginx proxy).
VITE_API_URL=/api